{
  "name": "vimonitor",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local Viessmann temperature history with ViCare and SQLite",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "npm run build:ui && node --env-file-if-exists=.env --watch src/server.ts",
    "dev:ui": "npm run build:ui -- --watch",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "tui": "node --env-file-if-exists=.env dist/server.js --tui",
    "backup": "node --env-file-if-exists=.env dist/backup.js",
    "build": "tsc && npm run build:ui",
    "build:ui": "esbuild frontend/main.tsx --bundle --platform=browser --format=iife --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist-public/app.js",
    "build:ui-test": "esbuild frontend/ui.test.tsx --bundle --platform=node --packages=external --format=esm --target=node24 --jsx=automatic --outfile=dist-public/ui.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "npm run build:ui && npm run build:ui-test && node --test src/*.test.ts dist-public/ui.test.mjs"
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
